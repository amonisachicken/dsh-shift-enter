+/**
+ * Composer Enter policy shared by the keymap and the shortcut reference. The
+ * standard policy submits on plain Enter; a profile plugin may instead make
+ * Shift+Enter submit, leaving plain Enter to break the line.
+ */
+
+/** Enter gesture that submits a draft; the complementary gesture breaks the line. */
+export type ComposerSendGesture = 'enter' | 'shift-enter'
+
+/** Standard policy: plain Enter submits, Shift+Enter breaks the line. */
+export const DEFAULT_COMPOSER_SEND_GESTURE: ComposerSendGesture = 'enter'
